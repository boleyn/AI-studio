# =========================
# Required
# =========================
MONGODB_URI=mongodb://127.0.0.1:27017/nextjs_ai_studio
JWT_SECRET=replace_with_a_long_random_secret
AUTH_COOKIE_SECURE=

# LLM auth (AIProxy first)
AIPROXY_API_ENDPOINT=
AIPROXY_API_TOKEN=

# Optional fallback: direct OpenAI-compatible endpoint
OPENAI_BASE_URL=
CHAT_API_KEY=

# Optional model catalog (single source)
CHAT_MODEL_CONFIG_FILE=config/config.json
# Optional credential for the gpt-6.1-sol catalog connection.
GPT_61_SOL_API_KEY=

# Optional MCP
MCP_SERVER_URLS=
# Example (AIChat style):
# MCP_SERVER_URLS=[{"name":"mcp-gitlab-kb","url":"http://10.21.8.6:8008/sse"}]
# With headers:
# MCP_SERVER_URLS=[{"name":"mcp-private","url":"https://example.com/sse","headers":{"Authorization":"Bearer xxx"}}]
# MCP_SERVERS=

# ClawHub one-click edit key validation
AI_STUDIO_KEY=



# File parse config is read from config/config.json -> customPdfParse

# =========================
# Object Storage (S3/MinIO)
# =========================
STORAGE_VENDOR=minio
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BUCKET=
STORAGE_PRIVATE_BUCKET=
STORAGE_EXTERNAL_ENDPOINT=
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_MAX_RETRIES=3
# Chat attachment GET presigned URL TTL (seconds), default 2592000 = 30 days
CHAT_FILE_GET_URL_EXPIRES_IN_SECONDS=2592000

# =========================
# Optional Feishu OAuth
# =========================
FEISHU_APP_ID=
FEISHU_REDIRECT_URI=http://localhost:3000/auth/feishu/callback
FEISHU_APP_SECRET=
FEISHU_DEFAULT_PASSWORD=

# =========================
# Optional ClawHub publish bridge
# =========================
SKILL_HUB=
# Shared secret with ClawHub(SKILL_PUBLISH_PROXY_SECRET), used to bind publish owner by Feishu open_id.
SKILL_HUB_PROXY_SECRET=

# Agent plugin policy (built-ins enabled by default; disabled always wins)
# AGENT_PLUGINS={"disabled":["web","delegation"]}
# AGENT_MCP_SERVERS=[{"name":"example","transport":"http","url":"http://127.0.0.1:9000/mcp"}]

# Shared secret for the Web and sandbox Compose services
AGENT_SANDBOX_EXEC_TOKEN=

# Optional Google Drive connection for the library. Enable the Drive API for the
# OAuth web client and register this exact callback URI in Google Cloud.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:3100/api/library/connectors/google
# Use a persistent 32-byte key encoded in base64 (openssl rand -base64 32).
# All app instances that serve the same database must use the same key.
LIBRARY_CONNECTOR_KEY=
